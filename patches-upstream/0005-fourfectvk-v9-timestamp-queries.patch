diff -ruN m/src/panfrost/vulkan/00-panvk-defaults.conf b/src/panfrost/vulkan/00-panvk-defaults.conf
--- m/src/panfrost/vulkan/00-panvk-defaults.conf	2026-10-13 05:39:03.963516729 +0000
+++ b/src/panfrost/vulkan/00-panvk-defaults.conf	2026-10-13 05:38:55.379516729 +0000
@@ -27,5 +27,18 @@
             <option name="pan_disable_clip_cull_distance" value="true" />
         </application>
 
+        <!--
+            Naruto Shippuden: Ultimate Ninja Storm 2 polls D3D11 timestamp
+            queries before its first frame. v9 reports no timestamp support,
+            the queries never become available and the game hangs on a white
+            or black window. Set pan_v9_timestamps=false in the environment
+            to turn it off again.
+        -->
+        <application name="Naruto Shippuden: Ultimate Ninja Storm 2" executable="NSUNS2.exe">
+            <option name="pan_v9_timestamps" value="true" />
+        </application>
+        <application name="Naruto Shippuden: Ultimate Ninja Storm 2, by API name" application_name_match="^NSUNS2[.]exe$">
+            <option name="pan_v9_timestamps" value="true" />
+        </application>
     </device>
 </driconf>
diff -ruN m/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c
--- m/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c	2026-10-13 05:39:03.755516729 +0000
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_query.c	2026-10-13 05:38:56.539516729 +0000
@@ -124,6 +124,30 @@
    UNUSED VK_FROM_HANDLE(panvk_cmd_buffer, cmd, commandBuffer);
    UNUSED VK_FROM_HANDLE(panvk_query_pool, pool, queryPool);
 
+#if PAN_ARCH == 9
+   if (panvk_v9_timestamps(cmd->vk.base.device)) {
+      /* PATCH v9: same ordering as CmdEndQuery. Close the current batch so
+       * the timestamp is taken after the work recorded so far, then write
+       * the GPU system timestamp and mark the query available. */
+      bool end_sync = cmd->cur_batch != NULL;
+
+      if (end_sync)
+         panvk_per_arch(cmd_close_batch)(cmd);
+
+      bool had_batch;
+      struct panvk_batch *batch = open_batch(cmd, &had_batch);
+      had_batch |= end_sync;
+
+      panvk_emit_write_job(cmd, batch, MALI_WRITE_VALUE_TYPE_SYSTEM_TIMESTAMP,
+                           panvk_query_report_dev_addr(pool, query), 0);
+      panvk_emit_write_job(cmd, batch, MALI_WRITE_VALUE_TYPE_IMMEDIATE_32,
+                           panvk_query_available_dev_addr(pool, query), 1);
+
+      close_batch(cmd, had_batch);
+      return;
+   }
+#endif
+
    panvk_stub();
 }
 
